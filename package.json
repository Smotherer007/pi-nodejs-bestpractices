    "pi-package",
    "pi-skill",
    "nodejs",
    "node",
    "best-practices",
    "typescript",
    "type-stripping",
    "performance",
    "streams",
    "testing",
    "coding-agent"
  ],
  "author": "Patrick Weppelmann",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Smotherer007/pi-nodejs-bestpractices.git"
  },
  "bugs": {
    "url": "https://github.com/Smotherer007/pi-nodejs-bestpractices/issues"
  },
  "scripts": {
    "build": "echo 'No build step defined'",
